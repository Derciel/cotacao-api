---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Demonstração - Sistema de Cotação 2025">
  <div class="demo-wrapper">
    <header class="demo-header animate-in">
      <div class="container">
        <div class="badge">Portfolio Showcase</div>
        <h1>Logística Inteligente <span>2025</span></h1>
        <p>Uma plataforma completa para gestão, cotação e análise de fretes com IA.</p>
      </div>
    </header>

    <main class="container">
      <section class="demo-grid">
        <!-- Coluna 1: Simulação de Cotação -->
        <div class="demo-card glass-glow animate-up" style="animation-delay: 0.1s">
          <div class="card-header">
            <i class="fas fa-calculator"></i>
            <h3>Cálculo de Frete Real-time</h3>
          </div>
          <div class="mock-ui">
            <div class="mock-field">
              <label>Destino</label>
              <div class="mock-input">São Paulo, SP - 01001-000</div>
            </div>
            <div class="mock-field">
              <label>Carga</label>
              <div class="mock-input">120kg | 3 Volumes | R$ 12.500,00</div>
            </div>
            <div class="mock-results">
                <div class="result-item active">
                    <span>Transportadora Alpha</span>
                    <strong>R$ 450,00</strong>
                </div>
                <div class="result-item">
                    <span>Logistics Express</span>
                    <strong>R$ 510,00</strong>
                </div>
            </div>
          </div>
        </div>

        <!-- Coluna 2: Dashboard Analytics -->
        <div class="demo-card glass-glow animate-up" style="animation-delay: 0.2s">
          <div class="card-header">
            <i class="fas fa-chart-line"></i>
            <h3>Analytics & BI</h3>
          </div>
          <div class="mock-dashboard">
            <div class="stats-row">
              <div class="stat-bubble">
                <small>Economia</small>
                <strong>18%</strong>
              </div>
              <div class="stat-bubble">
                <small>Fretes</small>
                <strong>1.2k</strong>
              </div>
            </div>
            <div class="mock-chart">
              <div class="bar" style="height: 40%"></div>
              <div class="bar" style="height: 60%"></div>
              <div class="bar" style="height: 85%"></div>
              <div class="bar" style="height: 70%"></div>
              <div class="bar highlight" style="height: 95%"></div>
            </div>
          </div>
        </div>

        <!-- Coluna 3: IA Insights -->
        <div class="demo-card glass-glow animate-up" style="animation-delay: 0.3s">
            <div class="card-header">
              <i class="fas fa-robot"></i>
              <h3>IA Insights</h3>
            </div>
            <div class="mock-ai">
              <div class="ai-card opportunity">
                  <i class="fas fa-lightbulb"></i>
                  <p><strong>Oportunidade:</strong> Agrupar pedidos para a região Sul pode reduzir custos em 12%.</p>
              </div>
              <div class="ai-card tip">
                  <i class="fas fa-info-circle"></i>
                  <p><strong>Dica:</strong> Transportadora Beta está com lead time 15% menor esta semana.</p>
              </div>
            </div>
        </div>
      </section>

      <section class="video-preview animate-up" style="animation-delay: 0.4s">
          <div class="section-title">
              <h2>Visualização do Fluxo</h2>
              <p>Veja o sistema em ação através desta demonstração rápida.</p>
          </div>
          <div class="video-container glass-glow">
              <video width="100%" height="auto" controls poster="/video_poster.jpg">
                  <source src="/video_demonstracao.mp4" type="video/mp4">
                  Seu navegador não suporta vídeos.
              </video>
          </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .demo-wrapper {
    background: #050a15;
    color: #ffffff;
    min-height: 80vh;
    font-family: 'Inter', sans-serif;
    padding-bottom: 50px;
    border-radius: 20px;
    overflow: hidden;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .demo-header {
    padding: 60px 0 40px;
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(0, 163, 255, 0.1);
    color: #00a3ff;
    border-radius: 99px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 20px;
    border: 1px solid #00a3ff;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 900;
    margin-bottom: 20px;
    color: #fff;
  }

  h1 span {
    color: #00a3ff;
  }

  .demo-header p {
    font-size: 1.1rem;
    color: #94a3b8;
    max-width: 500px;
    margin: 0 auto;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 60px;
  }

  .demo-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 25px;
    backdrop-filter: blur(10px);
    transition: 0.3s;
  }

  .demo-card:hover {
    transform: translateY(-5px);
    border-color: #00a3ff;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 25px;
  }

  .card-header i {
    font-size: 1.3rem;
    color: #00a3ff;
  }

  .card-header h3 {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .mock-ui, .mock-dashboard, .mock-ai {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .mock-field label {
    font-size: 0.7rem;
    color: #94a3b8;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 5px;
  }

  .mock-input {
    background: rgba(255, 255, 255, 0.05);
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .result-item {
    display: flex;
    justify-content: space-between;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    font-size: 0.8rem;
  }

  .result-item.active {
    background: rgba(0, 163, 255, 0.1);
    border: 1px solid #00a3ff;
  }

  .stats-row {
    display: flex;
    gap: 10px;
  }

  .stat-bubble {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    padding: 12px;
    border-radius: 14px;
    text-align: center;
  }

  .stat-bubble small { font-size: 0.65rem; color: #94a3b8; }
  .stat-bubble strong { display: block; font-size: 1.3rem; color: #00a3ff; }

  .mock-chart {
    height: 120px;
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .bar {
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px 4px 0 0;
  }

  .bar.highlight { background: #00a3ff; }

  .ai-card {
    display: flex;
    gap: 12px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    font-size: 0.8rem;
  }

  .video-preview {
      text-align: center;
  }

  .section-title h2 { font-size: 2rem; margin-bottom: 10px; }
  .section-title p { color: #94a3b8; margin-bottom: 30px; }

  .video-container {
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-up {
    animation: fadeInUp 0.5s ease-out both;
  }
</style>
