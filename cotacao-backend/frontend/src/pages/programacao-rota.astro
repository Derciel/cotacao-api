---
// src/pages/programacao-rota.astro
import MainLayout from '../layouts/MainLayout.astro';
import ProgramacaoRotaComponent from '../components/ProgramacaoRota.vue';
---

<MainLayout title="Programação de Rota | Nicopel Cargo">
  <!-- CSS e JS do Leaflet para renderização fluida e leve do mapa interativo -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>

  <div class="page-container">
    <ProgramacaoRotaComponent client:load />
  </div>
</MainLayout>

<style is:global>
  /* Correção de z-index do Leaflet para não sobrepor menus flutuantes e toasters */
  .leaflet-top, .leaflet-bottom {
    z-index: 400 !important;
  }
  .leaflet-pane {
    z-index: 300 !important;
  }
</style>
