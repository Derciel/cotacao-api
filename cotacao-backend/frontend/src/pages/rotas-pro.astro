---
// src/pages/rotas-pro.astro
import MainLayout from '../layouts/MainLayout.astro';
import RoteirizadorPro from '../components/RoteirizadorPro.vue';
---

<MainLayout title="Roteirizador Pro | Nicopel Cargo" hideNavbar={true}>
  <!-- CSS e JS do Leaflet para renderização do mapa -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>

  <RoteirizadorPro client:load />
</MainLayout>

<style is:global>
  /* Força a remoção de paddings e margens do layout base para permitir mapa fullscreen */
  html, body {
    margin: 0;
    padding: 0;
    height: 100vh;
    overflow: hidden;
  }
  
  .bg-wrapper, .footer {
    display: none !important;
  }

  .main-content {
    padding: 0 !important;
    margin: 0 !important;
    height: 100vh;
    width: 100vw;
  }
  
  .container {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    height: 100%;
    width: 100%;
  }

  /* Correção de z-index do Leaflet para não sobrepor menus e modais */
  .leaflet-top, .leaflet-bottom {
    z-index: 400 !important;
  }
  .leaflet-pane {
    z-index: 300 !important;
  }
</style>
