---
import MainLayout from '../layouts/MainLayout.astro';
import AnalisePedidos from '../components/AnalisePedidos.vue';
---

<MainLayout title="Análise de Pedidos">
    <div class="header-section mb-30">
        <h1 class="page-title">Análise de Pedidos</h1>
        <p class="page-subtitle">Consolide dados de peso e volume de itens, aplique filtros logísticos por cliente/data e exporte para faturamento.</p>
    </div>

    <AnalisePedidos client:load />
</MainLayout>

<style>
.header-section {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 40px;
}
.page-title {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--text-main), #64748b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 10px;
}
.page-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
}
</style>
