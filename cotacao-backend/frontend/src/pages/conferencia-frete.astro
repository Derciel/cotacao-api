---
// e:/projetos em andamento/projeto-cotacao-2025/cotacao-backend/frontend/src/pages/conferencia-frete.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Conferência de Fretes | Nicopel Cargo">
  <div class="dev-container">
    <div class="glass-premium dev-card animate-fade-in">
      <div class="icon-wrapper">
        <i class="fas fa-tools"></i>
      </div>
      <h1>Módulo em Desenvolvimento</h1>
      <p>Estamos trabalhando na integração de comparação de valores entre NF e CTE para garantir que seu frete esteja sempre correto.</p>
      
      <div class="features-preview">
        <h3>Em breve:</h3>
        <ul>
          <li><i class="fas fa-check-circle"></i> Importação automática de XML de NFe/CTe</li>
          <li><i class="fas fa-check-circle"></i> Bate de valores com tabelas de frete</li>
          <li><i class="fas fa-check-circle"></i> Identificação de divergências em tempo real</li>
          <li><i class="fas fa-check-circle"></i> Relatórios de auditoria logística</li>
        </ul>
      </div>

      <div class="progress-bar">
        <div class="progress-fill"></div>
      </div>
      
      <a href="/" class="btn-back">
        <i class="fas fa-arrow-left"></i> Voltar ao Dashboard
      </a>
    </div>
  </div>
</MainLayout>

<style>
  .dev-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding: 20px;
  }

  .dev-card {
    max-width: 600px;
    width: 100%;
    padding: 60px 40px;
    text-align: center;
    border: 1px solid rgba(37, 99, 235, 0.1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
  }

  .icon-wrapper {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    margin: 0 auto 30px;
    box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3);
    animation: pulse 2s infinite;
  }

  h1 {
    font-size: 2rem;
    font-weight: 850;
    color: var(--text-main);
    margin-bottom: 20px;
    letter-spacing: -1px;
  }

  p {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .features-preview {
    text-align: left;
    background: rgba(255, 255, 255, 0.5);
    padding: 30px;
    border-radius: 16px;
    margin-bottom: 40px;
  }

  .features-preview h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: var(--primary);
  }

  .features-preview ul {
    list-style: none;
    padding: 0;
  }

  .features-preview li {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .features-preview i {
    color: #10b981;
  }

  .progress-bar {
    width: 100%;
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    margin-bottom: 40px;
    overflow: hidden;
  }

  .progress-fill {
    width: 35%;
    height: 100%;
    background: var(--primary);
    border-radius: 4px;
    animation: progressMove 3s infinite ease-in-out;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    transition: 0.3s;
  }

  .btn-back:hover {
    gap: 15px;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  @keyframes progressMove {
    0% { width: 10%; }
    50% { width: 45%; }
    100% { width: 10%; }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
